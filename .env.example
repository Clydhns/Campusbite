# Server-only values. Set real values through Vercel environment settings.
# Use Supabase's SESSION pooler (5432), not transaction pooling (6543).
PGHOST=your-session-pooler-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-reference
PGPASSWORD=
APP_SESSION_SECRET=
SUPABASE_URL=https://your-project-reference.supabase.co
SUPABASE_SECRET_KEY=
# Never set CAMPUSBITE_LOCAL_TEST or CAMPUSBITE_LOCAL_STORAGE_DIR in Vercel.
# They are for the local dev server and tests only (plain HTTP cookies and on-disk image storage).
